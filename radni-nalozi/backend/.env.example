# --- Baza ---
# Produkcija (Postgres):
# DATABASE_URL=postgresql+psycopg2://korisnik:lozinka@host:5432/radni_nalozi
# Lokalno (SQLite, zadano):
DATABASE_URL=sqlite:///./radni_nalozi.db

# --- JWT ---
JWT_SECRET=promijeni-me-dugackim-nasumicnim-nizom
JWT_EXPIRE_MINUTES=10080

# --- Upload fotografija ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# --- CORS (domena frontenda; "*" za razvoj) ---
CORS_ORIGINS=*

# --- Web Push (VAPID) — opcionalno ---
# Generiraj par: `python -m py_vapid --gen` ili preko web alata
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@bravel.hr

# --- Početni voditelj (kreira se pri prvom pokretanju) ---
SEED_ADMIN_USERNAME=voditelj
SEED_ADMIN_PASSWORD=bravel123
SEED_ADMIN_IME=Glavni voditelj
